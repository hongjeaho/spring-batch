<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.spring.batch.repository.backup.BackupMemberMapper">
    <insert id="insertMember" parameterType="memberVo">
        insert into member (name, email, createdTime, updatedTime)
        values (#{name}, #{email}, #{createdTime}, #{updatedTime})
    </insert>
</mapper>
